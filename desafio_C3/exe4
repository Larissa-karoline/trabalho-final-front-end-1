codigo_produto = int(input("Digite o código do produto (1 a 10): "))
peso_quilos = float(input("Digite o peso do produto em quilos: "))
codigo_pais = int(input("Digite o código do país de origem (1 a 3): "))

peso_gramas = peso_quilos * 1000

if 1 <= codigo_produto <= 4:
    preco_por_grama = 10.0
elif 5 <= codigo_produto <= 7:
    preco_por_grama = 25.0
elif 8 <= codigo_produto <= 10:
    preco_por_grama = 35.0
else:
    preco_por_grama = 0.0
    print("Código de produto inválido!")

# Cálculo do preço total do produto
preco_total_produto = peso_gramas * preco_por_grama

# 3. Definição da porcentagem de imposto com base no país de origem
if codigo_pais == 1:
    porcentagem_imposto = 0.0
elif codigo_pais == 2:
    porcentagem_imposto = 0.15
elif codigo_pais == 3:
    porcentagem_imposto = 0.25
else:
    porcentagem_imposto = 0.0
    print("Código de país inválido!")

# Cálculo do valor do imposto
valor_imposto = preco_total_produto * porcentagem_imposto

# 4. Cálculo do valor total
valor_total = preco_total_produto + valor_imposto

# Exibição dos resultados
print(f"\nPeso do produto convertido em gramas: {peso_gramas:.2f}g")
print(f"Preço total do produto comprado: R$ {preco_total_produto:.2f}")
print(f"Valor do imposto: R$ {valor_imposto:.2f}")
print(f"Valor total: R$ {valor_total:.2f}")